    <Content Include="$(SeizaNativeDll)" Condition="Exists('$(SeizaNativeDll)')">
      <Link>seiza_cabi.dll</Link>
      <!-- An explicit validation DLL may be older than the previous run's
           DLL. Always copy the selected bytes, not whichever timestamp wins. -->
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="$(RepositoryRoot)target\$(RustProfile)\seiza_platform.dll" Condition="Exists('$(RepositoryRoot)target\$(RustProfile)\seiza_platform.dll')">
      <Link>seiza_platform.dll</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

