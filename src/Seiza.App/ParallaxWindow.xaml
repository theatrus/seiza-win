<Window
    x:Class="Seiza.App.ParallaxWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Parallax Video">
    <Grid x:Name="ContentRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Padding="16,12" ColumnSpacing="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE714;" />
                <StackPanel>
                    <TextBlock Text="Parallax Video" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="SourceNameText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="340" />
                </StackPanel>
            </StackPanel>
            <Button x:Name="UndoButton" Grid.Column="1" Content="&#xE7A7;" FontFamily="Segoe Fluent Icons" AutomationProperties.Name="Undo video edit" ToolTipService.ToolTip="Undo video edit" Click="Undo_Click" />
            <Button x:Name="RedoButton" Grid.Column="2" Content="&#xE7A6;" FontFamily="Segoe Fluent Icons" AutomationProperties.Name="Redo video edit" ToolTipService.ToolTip="Redo video edit" Click="Redo_Click" />
            <Button x:Name="PrepareButton" Grid.Column="3" Content="Prepare Preview" Click="Prepare_Click" />
            <Button x:Name="ExportButton" Grid.Column="4" Content="Export Video…" Click="Export_Click" Style="{ThemeResource AccentButtonStyle}" />
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="430" />
                <ColumnDefinition Width="360" MinWidth="300" />
            </Grid.ColumnDefinitions>
            <Grid Padding="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,10" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ViewPicker" SelectedIndex="0" AutomationProperties.Name="Preview view" SelectionChanged="ViewPicker_SelectionChanged">
                        <ComboBoxItem Content="Source" />
                        <ComboBoxItem Content="Video Preview" />
                    </ComboBox>
                    <TextBlock x:Name="PickingText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Grid>
                <Grid x:Name="PreviewSurface" Grid.Row="1" Background="Black" PointerPressed="PreviewSurface_PointerPressed" SizeChanged="PreviewSurface_SizeChanged">
                    <Image x:Name="PreviewImage" Stretch="Uniform" />
                    <StackPanel x:Name="EmptyPreview" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="360">
                        <FontIcon Glyph="&#xE768;" FontSize="36" Foreground="White" />
                        <TextBlock Text="Preview your camera move" FontSize="20" Foreground="White" TextAlignment="Center" />
                        <TextBlock Text="Choose source and camera settings, then select Prepare Preview." TextWrapping="Wrap" Foreground="LightGray" TextAlignment="Center" />
                    </StackPanel>
                    <Canvas x:Name="MarkerCanvas" IsHitTestVisible="False">
                        <TextBlock x:Name="FocusMarker" Text="＋" FontSize="30" Foreground="Orange" Visibility="Collapsed" />
                    </Canvas>
                </Grid>
                <InfoBar x:Name="FitWarning" Grid.Row="2" IsClosable="False" Severity="Warning" Margin="0,8,0,0" />
                <Grid Grid.Row="3" Margin="0,12,0,8" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PlayButton" Content="&#xE768;" FontFamily="Segoe Fluent Icons" AutomationProperties.Name="Play preview" Click="Play_Click" />
                    <Slider x:Name="Timeline" Grid.Column="1" Minimum="0" Maximum="8" AutomationProperties.Name="Video time" ValueChanged="Timeline_ValueChanged" />
                    <TextBlock x:Name="TimeText" Grid.Column="2" FontSize="12" FontFamily="Cascadia Mono" VerticalAlignment="Center" />
                </Grid>
                <ContentControl x:Name="TourHost" Grid.Row="4" HorizontalContentAlignment="Stretch">
                <StackPanel x:Name="TourPanel" Spacing="8" Visibility="Collapsed">
                    <Grid ColumnSpacing="6" RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tour Stops" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Load…" Click="LoadTour_Click" />
                        <Button Grid.Column="2" Content="Save…" Click="SaveTour_Click" />
                        <Button Grid.Row="1" Content="Add Point" Click="AddPoint_Click" HorizontalAlignment="Left" />
                        <Button Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Content="Add Whole Image" Click="AddWhole_Click" HorizontalAlignment="Right" />
                    </Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxHeight="145">
                        <StackPanel x:Name="StopStrip" Orientation="Horizontal" Spacing="8" />
                    </ScrollViewer>
                </StackPanel>
                </ContentControl>
            </Grid>
            <Border Grid.Column="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ComboBox x:Name="InspectorPicker" SelectedIndex="0" Margin="12" HorizontalAlignment="Stretch" AutomationProperties.Name="Inspector" SelectionChanged="InspectorPicker_SelectionChanged">
                        <ComboBoxItem Content="Source" />
                        <ComboBoxItem Content="Camera" />
                        <ComboBoxItem Content="Labels" />
                        <ComboBoxItem Content="Output" />
                    </ComboBox>
                    <ScrollViewer x:Name="InspectorScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ContentControl x:Name="InspectorHost" HorizontalContentAlignment="Stretch">
                        <StackPanel x:Name="InspectorPanel" Margin="16,0,16,16" Spacing="16" />
                        </ContentControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <StackPanel Grid.Row="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="12" Spacing="6">
            <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="True" Closed="ErrorBar_Closed" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="OperationProgress" Minimum="0" Maximum="1" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap" MaxLines="2" />
                    <TextBlock x:Name="ActivityDetailText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="2" />
                </StackPanel>
                <Button Grid.Column="2" Content="Activity…" Click="Activity_Click" />
                <Button x:Name="CancelButton" Grid.Column="3" Content="Cancel" Click="Cancel_Click" />
                <Button x:Name="ShowVideoButton" Grid.Column="4" Content="Show Video" Click="ShowVideo_Click" Visibility="Collapsed" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
