<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Seiza.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Seiza.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="SeizaDialogTitleTemplate">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Width="24" Height="24" VerticalAlignment="Center"
                           Source="ms-appx:///Assets/AppIcon.ico" />
                    <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap"
                               Style="{ThemeResource TitleTextBlockStyle}" />
                </Grid>
            </DataTemplate>
            <Style TargetType="ContentDialog">
                <Setter Property="TitleTemplate" Value="{StaticResource SeizaDialogTitleTemplate}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
