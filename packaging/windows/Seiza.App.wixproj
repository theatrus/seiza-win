<Project Sdk="WixToolset.Sdk/4.0.6" TreatAsLocalProperty="ExpectedPublishDirectory;ResolvedPublishDirectory">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <RepoRoot Condition="'$(RepoRoot)' == ''">$(MSBuildThisFileDirectory)..\..\</RepoRoot>
    <AppProject>$(RepoRoot)src\Seiza.App\Seiza.App.csproj</AppProject>
    <PublishDirectory>$(RepoRoot)artifacts\publish\win-x64\</PublishDirectory>
    <ExpectedPublishDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\artifacts\publish\win-x64\'))</ExpectedPublishDirectory>
    <ResolvedPublishDirectory>$([System.IO.Path]::GetFullPath('$(PublishDirectory)'))</ResolvedPublishDirectory>
    <SeizaVersion Condition="'$(SeizaVersion)' == ''">0.7.1</SeizaVersion>
    <OutputName>seiza-$(SeizaVersion)-windows-x86_64</OutputName>
    <OutputPath>$(RepoRoot)dist\</OutputPath>
    <IntermediateOutputPath>$(RepoRoot)artifacts\wix\</IntermediateOutputPath>
    <!-- Some Windows App SDK binaries carry resource language values that MSI's ICE03
         validator cannot represent, even though Windows loads them correctly. -->
    <SuppressIces>ICE03;ICE91</SuppressIces>
    <DefineConstants>SeizaVersion=$(SeizaVersion);PublishDir=$(PublishDirectory);RepoRoot=$(RepoRoot)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Heat" Version="4.0.6" />
    <PackageReference Include="WixToolset.UI.wixext" Version="4.0.6" />
    <PackageReference Include="WixToolset.Util.wixext" Version="4.0.6" />
  </ItemGroup>

  <ItemGroup>
    <InstallerDocumentation Include="$(RepoRoot)LICENSE" />
  </ItemGroup>

  <ItemGroup>
    <HarvestDirectory Include="$(PublishDirectory)">
      <ComponentGroupName>PublishedAppFiles</ComponentGroupName>
      <DirectoryRefId>APPLICATIONFOLDER</DirectoryRefId>
      <PreprocessorVariable>var.PublishDir</PreprocessorVariable>
      <SuppressCom>true</SuppressCom>
      <SuppressRegistry>true</SuppressRegistry>
      <SuppressRootDirectory>true</SuppressRootDirectory>
    </HarvestDirectory>
  </ItemGroup>

  <!-- Ordinarily this runs as part of building the MSI, so one command produces
       the installer. Release builds need a gap between publishing and
       harvesting in which to Authenticode-sign the application: call this
       target on its own, sign the published files, then build the MSI again
       with SeizaSkipPublish=true. Without the skip, publishing would run a
       second time and overwrite the signed files, because the SDK's copy
       compares size and timestamp and a signature changes both. -->
  <Target Name="PublishSeizaApp" BeforeTargets="GetHarvestDirectoryContent" Condition="'$(SeizaSkipPublish)' != 'true'">
    <!-- dotnet publish does not remove files that disappeared from the project.
         Start from an empty, dedicated output so Heat cannot package a stale
         binary left by local QA or an earlier application version. -->
    <Error
        Condition="'$(ResolvedPublishDirectory)' != '$(ExpectedPublishDirectory)'"
        Text="Refusing to clean unexpected publish directory $(ResolvedPublishDirectory). Expected $(ExpectedPublishDirectory)." />
    <RemoveDir Directories="$(ExpectedPublishDirectory)" />
    <MSBuild
        Projects="$(AppProject)"
        Targets="Publish"
        Properties="Configuration=Release;Platform=x64;RuntimeIdentifier=win-x64;Version=$(SeizaVersion);SelfContained=true;WindowsPackageType=None;WindowsAppSDKSelfContained=true;PublishSingleFile=false;PublishReadyToRun=true;PublishTrimmed=false;DebugSymbols=false;DebugType=None;PublishDir=$(PublishDirectory)" />
    <Copy SourceFiles="@(InstallerDocumentation)" DestinationFolder="$(PublishDirectory)" />
  </Target>

  <!-- Skipping the publish when nothing has been published would harvest an
       empty directory and produce an installer that carries no application at
       all, which is the kind of failure that survives a green build. -->
  <Target Name="RequireSeizaPublishOutput" BeforeTargets="GetHarvestDirectoryContent" Condition="'$(SeizaSkipPublish)' == 'true'">
    <Error
        Condition="!Exists('$(PublishDirectory)Seiza.App.exe')"
        Text="SeizaSkipPublish is set but $(PublishDirectory)Seiza.App.exe does not exist. Run the PublishSeizaApp target first." />
  </Target>
</Project>
