<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="Seiza for Windows"
      Manufacturer="Seiza"
      Version="$(var.SeizaVersion)"
      UpgradeCode="9E48A749-B21A-4EB9-9417-B1A5AA61D2F6"
      Language="1033"
      InstallerVersion="500"
      Scope="perMachine"
      Compressed="yes">
    <SummaryInformation Description="Seiza native astronomy image viewer and plate solver" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Seiza for Windows is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="APPLICATIONFOLDER" Name="Seiza for Windows" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="SeizaProgramMenu" Name="Seiza">
        <Component Id="SeizaStartMenuShortcut" Guid="E24E6145-1BC6-45A8-90B1-22942E8B36E1">
          <Shortcut
              Id="SeizaShortcut"
              Name="Seiza"
              Description="Open and solve astronomy images"
              Target="[APPLICATIONFOLDER]Seiza.App.exe"
              WorkingDirectory="APPLICATIONFOLDER" />
          <RemoveFolder Id="RemoveSeizaProgramMenu" On="uninstall" />
          <RegistryValue
              Root="HKCU"
              Key="Software\Seiza"
              Name="StartMenuShortcut"
              Type="integer"
              Value="1"
              KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Component Directory="APPLICATIONFOLDER" Id="SeizaFileAssociations" Guid="AD8A1151-9576-4890-8E9A-C35203674506">
      <RegistryValue
          Root="HKLM"
          Key="Software\RegisteredApplications"
          Name="Seiza"
          Type="string"
          Value="Software\Seiza\Capabilities"
          KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="Software\Seiza\Capabilities" Name="ApplicationName" Type="string" Value="Seiza" />
      <RegistryValue Root="HKLM" Key="Software\Seiza\Capabilities" Name="ApplicationDescription" Type="string" Value="Native astronomy image viewer and plate solver" />
      <RegistryValue Root="HKLM" Key="Software\Seiza\Capabilities\FileAssociations" Name=".fit" Type="string" Value="Seiza.FitsFile" />
      <RegistryValue Root="HKLM" Key="Software\Seiza\Capabilities\FileAssociations" Name=".fits" Type="string" Value="Seiza.FitsFile" />
      <RegistryValue Root="HKLM" Key="Software\Seiza\Capabilities\FileAssociations" Name=".fts" Type="string" Value="Seiza.FitsFile" />
      <RegistryValue Root="HKLM" Key="Software\Seiza\Capabilities\FileAssociations" Name=".xisf" Type="string" Value="Seiza.XisfFile" />
      <RegistryValue Root="HKLM" Key="Software\Classes\Seiza.FitsFile" Type="string" Value="FITS astronomy image" />
      <RegistryValue Root="HKLM" Key="Software\Classes\Seiza.FitsFile\DefaultIcon" Type="string" Value="[APPLICATIONFOLDER]Seiza.App.exe,0" />
      <RegistryValue Root="HKLM" Key="Software\Classes\Seiza.FitsFile\shell\open\command" Type="string" Value="&quot;[APPLICATIONFOLDER]Seiza.App.exe&quot; &quot;%1&quot;" />
      <RegistryValue Root="HKLM" Key="Software\Classes\Seiza.XisfFile" Type="string" Value="XISF astronomy image" />
      <RegistryValue Root="HKLM" Key="Software\Classes\Seiza.XisfFile\DefaultIcon" Type="string" Value="[APPLICATIONFOLDER]Seiza.App.exe,0" />
      <RegistryValue Root="HKLM" Key="Software\Classes\Seiza.XisfFile\shell\open\command" Type="string" Value="&quot;[APPLICATIONFOLDER]Seiza.App.exe&quot; &quot;%1&quot;" />
      <RegistryValue Root="HKLM" Key="Software\Classes\.fit\OpenWithProgids" Name="Seiza.FitsFile" Type="string" Value="" />
      <RegistryValue Root="HKLM" Key="Software\Classes\.fits\OpenWithProgids" Name="Seiza.FitsFile" Type="string" Value="" />
      <RegistryValue Root="HKLM" Key="Software\Classes\.fts\OpenWithProgids" Name="Seiza.FitsFile" Type="string" Value="" />
      <RegistryValue Root="HKLM" Key="Software\Classes\.xisf\OpenWithProgids" Name="Seiza.XisfFile" Type="string" Value="" />
    </Component>

    <!-- Explorer loads this native Rust COM server in an isolated dllhost.exe.
         Do not set DisableProcessIsolation: corrupt inputs must not run in Explorer. -->
    <Component Directory="APPLICATIONFOLDER" Id="SeizaThumbnailProviderRegistration" Guid="3D4BC8F0-3E45-478F-9114-11F69C96D201">
      <RegistryValue
          Root="HKLM"
          Key="Software\Classes\CLSID\{E8D56C6C-4E30-4C89-889A-D022180B710A}\InprocServer32"
          Type="string"
          Value="[APPLICATIONFOLDER]SeizaThumbnailProvider.dll"
          KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="Software\Classes\CLSID\{E8D56C6C-4E30-4C89-889A-D022180B710A}\InprocServer32" Name="ThreadingModel" Type="string" Value="Apartment" />

      <RegistryValue Root="HKLM" Key="Software\Classes\Seiza.FitsFile\shellex\{E357FCCD-A995-4576-B01F-234630154E96}" Type="string" Value="{E8D56C6C-4E30-4C89-889A-D022180B710A}" />
      <RegistryValue Root="HKLM" Key="Software\Classes\Seiza.XisfFile\shellex\{E357FCCD-A995-4576-B01F-234630154E96}" Type="string" Value="{E8D56C6C-4E30-4C89-889A-D022180B710A}" />
      <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.fit\shellex\{E357FCCD-A995-4576-B01F-234630154E96}" Type="string" Value="{E8D56C6C-4E30-4C89-889A-D022180B710A}" />
      <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.fits\shellex\{E357FCCD-A995-4576-B01F-234630154E96}" Type="string" Value="{E8D56C6C-4E30-4C89-889A-D022180B710A}" />
      <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.fts\shellex\{E357FCCD-A995-4576-B01F-234630154E96}" Type="string" Value="{E8D56C6C-4E30-4C89-889A-D022180B710A}" />
      <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.xisf\shellex\{E357FCCD-A995-4576-B01F-234630154E96}" Type="string" Value="{E8D56C6C-4E30-4C89-889A-D022180B710A}" />
    </Component>

    <!-- Preview Pane runs this second COM class in the x64 prevhost.exe
         surrogate. Stream initialization keeps low-integrity Explorer hosting
         isolated from the source path and from the WinUI/.NET application. -->
    <Component Directory="APPLICATIONFOLDER" Id="SeizaPreviewProviderRegistration" Guid="B79E4FD5-8C42-4C0F-964E-68CBF4568D42">
      <RegistryValue
          Root="HKLM"
          Key="Software\Classes\CLSID\{47B9C88E-38F5-4DE8-9A33-25E3989A7C51}"
          Type="string"
          Value="Seiza FITS and XISF Preview Handler"
          KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="Software\Classes\CLSID\{47B9C88E-38F5-4DE8-9A33-25E3989A7C51}" Name="AppID" Type="string" Value="{6D2B5079-2F0B-48DD-AB7F-97CEC514D30B}" />
      <RegistryValue Root="HKLM" Key="Software\Classes\CLSID\{47B9C88E-38F5-4DE8-9A33-25E3989A7C51}\InprocServer32" Type="string" Value="[APPLICATIONFOLDER]SeizaThumbnailProvider.dll" />
      <RegistryValue Root="HKLM" Key="Software\Classes\CLSID\{47B9C88E-38F5-4DE8-9A33-25E3989A7C51}\InprocServer32" Name="ThreadingModel" Type="string" Value="Apartment" />
      <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\PreviewHandlers" Name="{47B9C88E-38F5-4DE8-9A33-25E3989A7C51}" Type="string" Value="Seiza FITS and XISF Preview Handler" />

      <RegistryValue Root="HKLM" Key="Software\Classes\Seiza.FitsFile\shellex\{8895B1C6-B41F-4C1C-A562-0D564250836F}" Type="string" Value="{47B9C88E-38F5-4DE8-9A33-25E3989A7C51}" />
      <RegistryValue Root="HKLM" Key="Software\Classes\Seiza.XisfFile\shellex\{8895B1C6-B41F-4C1C-A562-0D564250836F}" Type="string" Value="{47B9C88E-38F5-4DE8-9A33-25E3989A7C51}" />
      <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.fit\shellex\{8895B1C6-B41F-4C1C-A562-0D564250836F}" Type="string" Value="{47B9C88E-38F5-4DE8-9A33-25E3989A7C51}" />
      <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.fits\shellex\{8895B1C6-B41F-4C1C-A562-0D564250836F}" Type="string" Value="{47B9C88E-38F5-4DE8-9A33-25E3989A7C51}" />
      <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.fts\shellex\{8895B1C6-B41F-4C1C-A562-0D564250836F}" Type="string" Value="{47B9C88E-38F5-4DE8-9A33-25E3989A7C51}" />
      <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.xisf\shellex\{8895B1C6-B41F-4C1C-A562-0D564250836F}" Type="string" Value="{47B9C88E-38F5-4DE8-9A33-25E3989A7C51}" />
    </Component>

    <Feature
        Id="MainFeature"
        Title="Seiza for Windows"
        Description="Seiza application and self-contained runtimes"
        Level="1"
        AllowAbsent="no"
        AllowAdvertise="no"
        ConfigurableDirectory="APPLICATIONFOLDER">
      <ComponentGroupRef Id="PublishedAppFiles" />
      <ComponentRef Id="SeizaStartMenuShortcut" />
      <ComponentRef Id="SeizaFileAssociations" />
      <ComponentRef Id="SeizaThumbnailProviderRegistration" />
      <ComponentRef Id="SeizaPreviewProviderRegistration" />
    </Feature>

    <Binary
        Id="SeizaThumbnailProviderCustomActions"
        SourceFile="$(var.PublishDir)SeizaThumbnailProvider.dll" />
    <CustomAction
        Id="NotifyShellAssociations"
        BinaryRef="SeizaThumbnailProviderCustomActions"
        DllEntry="NotifyShellAssociations"
        Execute="immediate"
        Return="check" />
    <InstallExecuteSequence>
      <Custom Action="NotifyShellAssociations" After="InstallFinalize" />
    </InstallExecuteSequence>

    <Icon Id="SeizaAppIcon" SourceFile="$(var.RepoRoot)src\Seiza.App\Assets\AppIcon.ico" />
    <Property Id="ARPPRODUCTICON" Value="SeizaAppIcon" />
    <Property Id="WIXUI_INSTALLDIR" Value="APPLICATIONFOLDER" />
    <ui:WixUI Id="WixUI_InstallDir" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.RepoRoot)packaging\windows\License.rtf" />

    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Seiza" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <CustomAction
        Id="SetLaunchSeizaTarget"
        Property="WixUnelevatedShellExecTarget"
        Value="[APPLICATIONFOLDER]Seiza.App.exe" />
    <CustomAction
        Id="LaunchSeiza"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixUnelevatedShellExec"
        Execute="immediate"
        Return="check" />
    <UI>
      <Publish
          Dialog="ExitDialog"
          Control="Finish"
          Event="DoAction"
          Value="SetLaunchSeizaTarget"
          Order="1"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
      <Publish
          Dialog="ExitDialog"
          Control="Finish"
          Event="DoAction"
          Value="LaunchSeiza"
          Order="2"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
  </Package>
</Wix>
